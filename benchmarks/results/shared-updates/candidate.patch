diff --git a/src/style.js b/src/style.js
new file mode 100644
--- /dev/null
+++ b/src/style.js
@@ -0,0 +1,16 @@
+// Browsers serialize colors and shorthands differently from their input. Keep
+// both forms, and inspect the live declaration so host edits are repaired.
+// Weak keys do not retain surfaces or layers after unregistration/disposal.
+const declarations = new WeakMap();
+
+export function setStyle(style, property, value) {
+  const desired = String(value);
+  let properties = declarations.get(style);
+  const previous = properties?.get(property);
+  if (previous?.desired === desired &&
+      style.getPropertyValue(property) === previous.actual &&
+      style.getPropertyPriority(property) === "") return;
+  style.setProperty(property, desired);
+  if (!properties) declarations.set(style, properties = new Map());
+  properties.set(property, { desired, actual: style.getPropertyValue(property) });
+}
